      "source": [
        "faq = {\n",
        "    \"o que é tesouro selic\": \"Tesouro Selic é um título público do governo brasileiro considerado de baixo risco.\",\n",
        "    \"o que é cdi\": \"CDI é uma taxa usada como referência para diversos investimentos.\",\n",
        "    \"o que é investimento\": \"Investimento é aplicar dinheiro esperando retorno futuro.\"\n",
        "}"
      ],
      "metadata": {
        "id": "RFjhPeGZIi-4"
      },
      "execution_count": 2,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def simulador_investimento(valor_mensal, taxa, meses):\n",
        "    montante = 0\n",
        "\n",
        "    for i in range(meses):\n",
        "        montante = (montante + valor_mensal) * (1 + taxa)\n",
        "\n",
        "    return round(montante, 2)"
      ],
      "metadata": {
        "id": "X6eoZR_7IlIK"
      },
      "execution_count": 3,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def assistente():\n",
        "\n",
        "    pergunta = input(\"Digite sua pergunta financeira: \").lower()\n",
        "\n",
        "    if pergunta in faq:\n",
        "        print(\"Assistente:\", faq[pergunta])\n",
        "\n",
        "    elif \"simular investimento\" in pergunta:\n",
        "\n",
        "        valor = float(input(\"Valor mensal: \"))\n",
        "        taxa = float(input(\"Taxa mensal (ex: 0.01 para 1%): \"))\n",
        "        meses = int(input(\"Quantidade de meses: \"))\n",
        "\n",
        "        resultado = simulador_investimento(valor, taxa, meses)\n",
        "\n",
        "        print(\"Assistente:\")\n",
        "        print(f\"Se você investir R${valor} por {meses} meses, terá aproximadamente R${resultado}\")\n",
        "\n",
        "    else:\n",
        "        print(\"Assistente: Desculpe, ainda estou aprendendo sobre esse assunto.\")"
      ],
